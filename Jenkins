pipeline {

    agent any

    tools {
        maven 'Maven'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }
        stage('Repeat'){
                   steps{
                      script{
                         for(int i=1; i<5;i++) {
                            echo"Run number ${i}"
                            bat 'mvn test'
                            sleep 5
                       }
                  }
              }
          }
    }

    post {
        success {
            emailext(
                to: 'reshmak.kiaq@gmail.com',
                subject: "Jenkins SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Build completed successfully.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
"""
            )
        }

        failure {
            emailext(
                to: 'reshmak.kiaq@gmail.com',
                subject: "Jenkins FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Build failed.
Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
"""
            )
        }
    }
}
